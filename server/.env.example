# NepalStay Backend Environment Configuration

# Server Port
PORT=5000

# MongoDB connection string. Put real credentials only in server/.env
# or your hosting provider's secret/environment-variable settings.
# Atlas: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/nepalstay
MONGODB_URI=

# Generate a unique random secret of at least 32 characters.
JWT_SECRET=

# Platform Administrator Gmail (mail sender identity only; never grants admin privileges)
ADMIN_GMAIL=

# Base32 TOTP secret for a manually provisioned administrator account
ADMIN_TOTP_SECRET=

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=

# Allowed client URL(s), comma-separated when needed
CLIENT_URL=http://localhost:5173

# EmailJS backend configuration
# Enable non-browser API requests in EmailJS Account > Security.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
