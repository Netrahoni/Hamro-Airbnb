# NepalStay Backend Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String (Atlas URI or local MongoDB)
# Format 1 (Atlas SRV): mongodb+srv://<username>:<password>@cluster0.h4sqozu.mongodb.net/nepalstay?retryWrites=true&w=majority
# Format 2 (Local): mongodb://127.0.0.1:27017/nepalstay
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.h4sqozu.mongodb.net/nepalstay?retryWrites=true&w=majority

# JWT Secret Key for token signing
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters

# Platform Administrator Gmail (mail sender identity only; never grants admin privileges)
ADMIN_GMAIL=

# Base32 TOTP secret for a manually provisioned administrator account
# Generate a unique secret and enroll it in an authenticator app before enabling admin sign-in.
ADMIN_TOTP_SECRET=

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=

# Allowed Client URL for CORS
CLIENT_URL=http://localhost:5173

# Gmail SMTP for sending verification codes directly to inboxes:
# To send real emails from your Gmail account, generate a 16-character App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Turn on 2-Step Verification
# 3. Search for "App passwords" -> Create one named "NepalStay"
# 4. Paste the 16-character code below without spaces:
EMAIL_USER=
EMAIL_PASS=

